body {
    font-family: Arial, sans-serif;
    background-color: #f4f4f4;
    text-align: center;
    margin: 0;
    padding: 0;
}

.container {
    max-width: 400px;
    margin: 50px auto;
    background: white;
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
}

.profile-img {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    margin-bottom: 10px;
}

h1 {
    margin: 10px 0;
    color: #333;
}

p {
    color: #666;
}

.link {
    display: block;
    background: #007bff;
    color: white;
    text-decoration: none;
    padding: 10px;
    margin: 10px 0;
    border-radius: 5px;
    transition: 0.3s;
}

.link:hover {    background: #0056b3;
}

footer {
    margin-top: 20px;
    font-size: 14px;
    color: #888;
}
